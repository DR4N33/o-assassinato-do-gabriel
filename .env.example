# Copiar para .env (o .env nunca vai para o GitHub)

# Palavra-passe da organização (André e Rosa). Mínimo 8 caracteres — usem uma frase longa.
ADMIN_PASSWORD=

# Porta local (opcional)
PORT=8080

# Cloudflare Tunnel (opcional): Zero Trust → Networks → Tunnels → Create → copiar o token
# Public hostname do túnel → Service: http://app:8080
TUNNEL_TOKEN=
